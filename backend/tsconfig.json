{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "lib": ["ES2022"],

    "esModuleInterop": true,

    "strict": true,

    "rootDir": "src",
    "outDir": "dist",

    "sourceMap": true,

    "noEmitOnError": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "incremental": true
  },

  "include": ["src/**/*"],

  "exclude": ["node_modules", "dist"]
}
