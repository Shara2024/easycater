{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": ["ES2022"],

    "esModuleInterop": true,

    "strict": true,

    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "ignoreDeprecations": "6.0",

    "sourceMap": true,

    "noEmitOnError": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "incremental": true
  },

  "include": ["src/**/*"],

  "exclude": ["node_modules", "dist"]
}
